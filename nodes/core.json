{
  "category": "Flow",
  "nodes": [
    {
      "type": "start",
      "label": "Start",
      "kind": "statement",
      "exec_in": false,
      "builtin": "start",
      "summary": "Where the graph begins. Steps run from here, in order.",
      "help": "Every graph needs exactly one Start node. Drag from its arrow to the first thing that should happen.",
      "tags": [
        "begin",
        "entry",
        "run"
      ]
    },
    {
      "type": "if",
      "label": "If",
      "kind": "scope",
      "exec_bodies": [
        "then"
      ],
      "summary": "Runs the steps inside only when the condition is true.",
      "inputs": [
        {
          "name": "condition",
          "type": "int",
          "label": "Condition",
          "default": "0",
          "desc": "Anything that is not zero counts as true."
        }
      ],
      "code": "if ({condition})\n{\n    {then}\n}",
      "tags": [
        "when",
        "conditional",
        "branch",
        "test"
      ]
    },
    {
      "type": "if_else",
      "label": "If / Else",
      "kind": "scope",
      "exec_bodies": [
        "then",
        "otherwise"
      ],
      "summary": "Takes one path when the condition is true and another when it is false.",
      "inputs": [
        {
          "name": "condition",
          "type": "int",
          "label": "Condition",
          "default": "0"
        }
      ],
      "code": "if ({condition})\n{\n    {then}\n}\nelse\n{\n    {otherwise}\n}",
      "tags": [
        "when",
        "conditional",
        "branch",
        "either"
      ]
    },
    {
      "type": "for_range",
      "label": "Repeat",
      "kind": "scope",
      "exec_bodies": [
        "body"
      ],
      "summary": "Runs the steps inside a fixed number of times.",
      "help": "Count starts at 0, so repeating 5 times gives you 0, 1, 2, 3, 4.",
      "inputs": [
        {
          "name": "count",
          "type": "int",
          "label": "Times",
          "default": "10"
        }
      ],
      "outputs": [
        {
          "name": "index",
          "type": "int",
          "label": "Number",
          "scope": "body",
          "desc": "Which time round the loop this is. Only exists inside."
        }
      ],
      "code": "for (int {index} = 0; {index} < {count}; {index}++)\n{\n    {body}\n}",
      "tags": [
        "loop",
        "for",
        "iterate",
        "times"
      ]
    },
    {
      "type": "foreach",
      "label": "For Each",
      "kind": "scope",
      "exec_bodies": [
        "body"
      ],
      "summary": "Runs the steps inside once for every item in a list.",
      "params": [
        {
          "name": "type",
          "label": "Item Type",
          "kind": "menu",
          "default": "vector",
          "menu": [
            "float",
            "int",
            "vector",
            "vector2",
            "vector4",
            "string",
            "matrix"
          ],
          "retypes": [
            "items",
            "item"
          ]
        }
      ],
      "inputs": [
        {
          "name": "items",
          "type": "any[]",
          "label": "List"
        }
      ],
      "outputs": [
        {
          "name": "index",
          "type": "int",
          "label": "Position",
          "scope": "body"
        },
        {
          "name": "item",
          "type": "any",
          "label": "Item",
          "scope": "body"
        }
      ],
      "code": "int {index};\n{type} {item};\nforeach ({index}, {item}; {items})\n{\n    {body}\n}",
      "tags": [
        "loop",
        "iterate",
        "array",
        "list",
        "each"
      ]
    },
    {
      "type": "break_if",
      "label": "Stop Repeating If",
      "kind": "statement",
      "summary": "Leaves the surrounding loop early when the condition is true.",
      "inputs": [
        {
          "name": "condition",
          "type": "int",
          "label": "Condition",
          "default": "0"
        }
      ],
      "code": "if ({condition})\n    break;",
      "tags": [
        "break",
        "exit",
        "loop",
        "stop"
      ],
      "requires_loop": true
    },
    {
      "type": "skip_if",
      "label": "Skip Rest If",
      "kind": "statement",
      "summary": "Jumps to the next turn of the surrounding loop when the condition is true.",
      "inputs": [
        {
          "name": "condition",
          "type": "int",
          "label": "Condition",
          "default": "0"
        }
      ],
      "code": "if ({condition})\n    continue;",
      "tags": [
        "continue",
        "skip",
        "loop",
        "next"
      ],
      "requires_loop": true
    },
    {
      "type": "note",
      "label": "Note",
      "kind": "statement",
      "summary": "A comment in the generated code. Does nothing.",
      "params": [
        {
          "name": "text",
          "label": "Text",
          "kind": "string",
          "default": "note"
        }
      ],
      "code": "// {text}",
      "tags": [
        "comment",
        "label",
        "documentation"
      ]
    },
    {
      "type": "var_make",
      "category": "Variables",
      "label": "Make Variable",
      "kind": "statement",
      "builtin": "var_declare",
      "summary": "Creates a named value you can change later and read anywhere after this.",
      "help": "Use this when a value has to survive a loop: make it before the loop, change it inside, read it after.",
      "params": [
        {
          "name": "name",
          "label": "Name",
          "kind": "string",
          "default": "total"
        },
        {
          "name": "type",
          "label": "Type",
          "kind": "menu",
          "default": "float",
          "menu": [
            "float",
            "int",
            "vector",
            "string",
            "vector4",
            "matrix",
            "vector2",
            "matrix2",
            "matrix3",
            "dict",
            "int[]",
            "float[]",
            "vector2[]",
            "vector[]",
            "vector4[]",
            "matrix2[]",
            "matrix3[]",
            "matrix[]",
            "string[]",
            "dict[]"
          ],
          "retypes": [
            "value"
          ]
        }
      ],
      "inputs": [
        {
          "name": "value",
          "type": "any",
          "label": "Starting Value",
          "default": "0"
        }
      ],
      "tags": [
        "variable",
        "declare",
        "store",
        "accumulate"
      ]
    },
