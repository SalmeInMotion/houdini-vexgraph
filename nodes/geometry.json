    {
      "type": "closest_surface_point",
      "label": "Closest Point On Surface",
      "summary": "Finds the nearest spot anywhere on a surface, not just at its points.",
      "help": "Gives you the distance, which primitive it landed on, and where on that primitive. Feed the last two into Position On Primitive to get the actual point in space.",
      "params": [
        {
          "name": "input",
          "label": "Input",
          "kind": "int",
          "default": "1"
        }
      ],
      "inputs": [
        {
          "name": "position",
          "type": "vector",
          "label": "Position",
          "default": "@P"
        }
      ],
      "outputs": [
        {
          "name": "distance",
          "type": "float",
          "label": "Distance"
        },
        {
          "name": "primitive",
          "type": "int",
          "label": "Primitive"
        },
        {
          "name": "uv",
          "type": "vector",
          "label": "Spot On Primitive"
        }
      ],
      "code": "int {primitive} = -1;\nvector {uv} = {0, 0, 0};\nfloat {distance} = xyzdist({input}, {position}, {primitive}, {uv});",
      "tags": [
        "xyzdist",
        "closest",
        "surface",
        "distance",
        "project",
        "stick"
      ]
    },
    {
      "type": "position_on_primitive",
      "label": "Position On Primitive",
      "summary": "Turns a primitive and a spot on it into a position in space.",
      "params": [
        {
          "name": "input",
          "label": "Input",
          "kind": "int",
          "default": "1"
        },
        {
          "name": "attrib",
          "label": "Attribute",
          "kind": "attrib",
          "default": "P"
        },
        {
          "name": "type",
          "label": "Type",
          "kind": "menu",
          "default": "vector",
          "menu": [
            "float",
            "vector",
            "vector2",
            "vector4"
          ],
          "retypes": [
            "value"
          ]
        }
      ],
      "inputs": [
        {
          "name": "primitive",
          "type": "int",
          "label": "Primitive",
          "default": "0"
        },
        {
          "name": "uv",
          "type": "vector",
          "label": "Spot On Primitive",
          "default": "{0, 0, 0}"
        }
      ],
      "outputs": [
        {
          "name": "value",
          "type": "any",
          "label": "Value"
        }
      ],
      "code": "{type} {value} = primuv({input}, \"{attrib}\", {primitive}, {uv});",
      "tags": [
        "primuv",
        "interpolate",
        "surface",
        "sample",
        "uv"
      ]
    },
    {
      "type": "add_point",
      "label": "Add Point",
      "kind": "statement",
      "summary": "Creates a new point at a position.",
      "inputs": [
        {
          "name": "position",
          "type": "vector",
          "label": "Position",
          "default": "{0, 0, 0}"
        }
      ],
      "outputs": [
        {
          "name": "point_number",
          "type": "int",
          "label": "New Point"
        }
      ],
      "code": "int {point_number} = addpoint(0, {position});",
      "tags": [
        "addpoint",
        "create",
        "new",
        "spawn",
        "scatter"
      ]
    },
    {
      "type": "remove_point",
      "label": "Remove Point",
      "kind": "statement",
      "summary": "Deletes a point.",
      "help": "Deleting the point being worked on is the usual case, and the default does that.",
      "inputs": [
        {
          "name": "point_number",
          "type": "int",
          "label": "Point Number",
          "default": "@elemnum"
        }
      ],
      "code": "removepoint(0, {point_number});",
      "tags": [
        "removepoint",
        "delete",
        "kill",
        "cull",
        "destroy"
      ]
    },
    {
      "type": "write_point_attribute",
      "label": "Write Point Attribute",
      "kind": "statement",
      "summary": "Writes an attribute onto any point, not just the one being worked on.",
      "params": [
        {
          "name": "attrib",
          "label": "Attribute",
          "kind": "attrib",
          "default": "Cd"
        },
        {
          "name": "type",
          "label": "Type",
          "kind": "menu",
          "default": "vector",
          "menu": [
            "float",
            "int",
            "vector",
            "vector2",
            "vector4",
            "string",
            "matrix2",
            "matrix3",
            "matrix",
            "dict"
          ],
          "retypes": [
            "value"
          ]
        }
      ],
      "inputs": [
        {
          "name": "point_number",
          "type": "int",
          "label": "Point Number",
          "default": "0"
        },
        {
          "name": "value",
          "type": "any",
          "label": "Value"
        }
      ],
      "code": "setpointattrib(0, \"{attrib}\", {point_number}, {value}, \"set\");",
      "tags": [
        "setpointattrib",
        "write",
        "other",
        "attribute"
      ]
    },
    {
      "type": "in_group",
      "label": "Is In Group",
      "summary": "True when the point being worked on belongs to a group.",
      "params": [
        {
          "name": "input",
          "label": "Input",
          "kind": "int",
          "default": "0"
        },
        {
          "name": "group",
