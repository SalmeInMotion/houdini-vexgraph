{
  "category": "Geometry",
  "nodes": [
    {
      "type": "point_count",
      "label": "Point Count",
      "repeatable": true,
      "summary": "How many points an input has.",
      "params": [
        {
          "name": "input",
          "label": "Input",
          "kind": "int",
          "default": "0"
        }
      ],
      "outputs": [
        {
          "name": "count",
          "type": "int",
          "label": "Count"
        }
      ],
      "expr": "npoints({input})",
      "tags": [
        "npoints",
        "total",
        "how many",
        "count"
      ]
    },
    {
      "type": "primitive_count",
      "label": "Primitive Count",
      "repeatable": true,
      "summary": "How many primitives an input has.",
      "params": [
        {
          "name": "input",
          "label": "Input",
          "kind": "int",
          "default": "0"
        }
      ],
      "outputs": [
        {
          "name": "count",
          "type": "int",
          "label": "Count"
        }
      ],
      "expr": "nprimitives({input})",
      "tags": [
        "nprimitives",
        "faces",
        "polygons",
        "count"
      ]
    },
    {
      "type": "nearest_point",
      "label": "Nearest Point",
      "summary": "Finds the point of an input closest to a position.",
      "help": "Input 0 is the geometry flowing through this wrangle. Wire a second input into the SOP to search a different piece of geometry.",
      "params": [
        {
          "name": "input",
          "label": "Input",
          "kind": "int",
          "default": "1"
        }
      ],
      "inputs": [
        {
          "name": "position",
          "type": "vector",
          "label": "Position",
          "default": "@P"
        }
      ],
      "outputs": [
        {
          "name": "point_number",
          "type": "int",
          "label": "Point Number"
        }
      ],
      "code": "int {point_number} = nearpoint({input}, {position});",
      "tags": [
        "nearpoint",
        "closest",
        "near",
        "find",
        "snap"
      ]
    },
    {
      "type": "nearest_points",
      "label": "Nearest Points",
      "summary": "Finds every point of an input within a radius, closest first.",
      "params": [
        {
          "name": "input",
          "label": "Input",
          "kind": "int",
          "default": "1"
        }
      ],
      "inputs": [
        {
          "name": "position",
          "type": "vector",
          "label": "Position",
          "default": "@P"
        },
        {
          "name": "radius",
          "type": "float",
          "label": "Radius",
          "default": "1"
        },
        {
          "name": "maximum",
          "type": "int",
          "label": "Most To Find",
          "default": "10"
        }
      ],
      "outputs": [
        {
          "name": "point_numbers",
          "type": "int[]",
          "label": "Point Numbers"
        }
      ],
      "code": "int {point_numbers}[] = nearpoints({input}, {position}, {radius}, {maximum});",
      "tags": [
        "nearpoints",
        "closest",
        "neighbours",
        "neighbors",
        "radius",
        "search"
      ]
    },
    {
      "type": "read_point_attribute",
      "label": "Read Point Attribute",
      "summary": "Reads an attribute from any point, not just the one being worked on.",
      "params": [
        {
          "name": "input",
          "label": "Input",
          "kind": "int",
          "default": "0"
        },
        {
          "name": "attrib",
          "label": "Attribute",
          "kind": "attrib",
          "default": "P"
        },
        {
          "name": "type",
          "label": "Type",
          "kind": "menu",
          "default": "vector",
          "menu": [
            "float",
            "int",
            "vector",
            "vector2",
            "vector4",
            "string",
            "matrix2",
            "matrix3",
            "matrix",
            "dict"
          ],
          "retypes": [
            "value"
          ]
        }
      ],
      "inputs": [
        {
          "name": "point_number",
          "type": "int",
          "label": "Point Number",
          "default": "0"
        }
      ],
      "outputs": [
        {
          "name": "value",
          "type": "any",
          "label": "Value"
        }
      ],
      "code": "{type} {value} = point({input}, \"{attrib}\", {point_number});",
      "tags": [
        "point",
        "attribute",
        "read",
        "other",
        "lookup"
      ]
    },
